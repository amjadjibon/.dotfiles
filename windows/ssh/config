# Windows OpenSSH version of ssh/config.
# ControlMaster/ControlPath/ControlPersist are left out: Windows OpenSSH
# doesn't support connection multiplexing and errors out if they are set.
Host *
  # Keep connections alive
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Add keys to agent automatically (needs the ssh-agent service running)
  AddKeysToAgent yes

  # Prefer ed25519, fall back to rsa
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa
